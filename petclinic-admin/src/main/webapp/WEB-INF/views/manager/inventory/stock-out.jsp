<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="activeTab" value="stockOut" scope="request"/>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Xuất kho</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/dashboard.css"><style>.stock-out-form{padding:20px;background:#f7fbfa;border:1px solid #d7e6e3;border-radius:12px}.stock-out-form .form-group{padding:14px;border:1px solid #dbe9e6;border-radius:10px;background:#fff}.stock-out-form .form-label{display:block;margin-bottom:9px;color:#063e37!important;font-weight:750!important;font-size:15px}.stock-out-form .form-control{background:#fff!important;border:2px solid #a9c8c2!important;color:#092f2b!important;font-weight:550!important;box-shadow:none!important}.stock-out-form .form-control:hover{border-color:#638f87!important}.stock-out-form .form-control:focus{border-color:#078574!important;box-shadow:0 0 0 4px rgba(7,133,116,.16)!important}.stock-out-form .form-hint{display:block;margin-top:8px;color:#376b63!important;font-weight:600}.stock-out-notice{margin:0 0 18px;padding:14px 16px;border:1px solid #edc26c;border-left:5px solid #db8c00;border-radius:9px;background:#fff8eb;color:#704700!important;font-weight:600}.stock-out-actions{margin-top:20px;padding-top:18px;border-top:1px solid #cfe0dc}</style></head><body><div class="layout"><c:set var="activeModule" value="inventory" scope="request"/><%@ include file="/WEB-INF/views/common/_sidebar.jsp" %><main class="main-content main-content-wide"><div class="page-header"><h1>Xuất kho</h1><p class="page-sub">Ghi nhận hàng xuất dùng, hủy hoặc điều chỉnh tồn kho</p></div><%@ include file="/WEB-INF/views/common/_flash.jsp" %><%@ include file="/WEB-INF/views/manager/inventory/_subnav.jsp" %><div class="card" style="max-width:960px"><div class="card-header"><span class="card-title">Thông tin xuất kho</span></div><div class="card-body"><p class="stock-out-notice">Số lượng xuất không thể lớn hơn tồn hiện tại. Giao dịch được lưu vào lịch sử kho.</p><form class="stock-out-form" method="post" action="${pageContext.request.contextPath}/admin/inventory/stock-out"><div class="form-row col-2"><div class="form-group"><label class="form-label">Item xuất kho *</label><select id="stockItemKey" name="stockItemKey" class="form-control no-icon" required><option value="">-- Chọn item --</option><c:forEach items="${allItems}" var="item"><option value="${item.itemType}:${item.itemID}" data-stock="${item.stockQty}">[${item.itemType}] <c:out value="${item.displayName}"/> — tồn ${item.stockQty}</option></c:forEach></select><span id="stockHint" class="form-hint"></span></div><div class="form-group"><label class="form-label">Số lượng xuất *</label><input id="quantity" name="quantity" type="number" min="1" step="1" class="form-control no-icon" required></div></div><div class="form-group"><label class="form-label">Lý do xuất kho</label><select name="reason" class="form-control no-icon"><option value="Manual stock-out">Xuất thủ công</option><option value="Damaged / expired">Hàng hỏng / hết hạn</option><option value="Internal use">Sử dụng nội bộ</option><option value="Stock adjustment">Điều chỉnh kiểm kê</option></select></div><div class="form-actions stock-out-actions"><button class="btn btn-primary" onclick="return confirm('Xác nhận xuất kho?')">Lưu xuất kho</button><a class="btn btn-outline" href="${pageContext.request.contextPath}/admin/inventory">Về danh sách tồn kho</a></div></form></div></div></main></div><script>const item=document.getElementById('stockItemKey'),qty=document.getElementById('quantity'),hint=document.getElementById('stockHint');item.addEventListener('change',()=>{const stock=item.options[item.selectedIndex].dataset.stock||'';qty.max=stock;hint.textContent=stock?'Tồn hiện tại: '+stock:'';});</script></body></html>
