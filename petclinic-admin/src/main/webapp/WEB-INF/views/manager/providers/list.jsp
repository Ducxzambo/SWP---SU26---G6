<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Quản lý nhà cung cấp</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/dashboard.css"><style>
.provider-modal{display:none;position:fixed;inset:0;z-index:1000;background:radial-gradient(circle at top right,rgba(33,185,156,.2),transparent 35%),rgba(4,24,22,.7);backdrop-filter:blur(8px);align-items:center;justify-content:center;padding:24px;animation:fade .2s ease}.provider-modal.open{display:flex}.provider-dialog{width:min(720px,100%);max-height:90vh;overflow:auto;background:#fbfefd;border:1px solid rgba(255,255,255,.55);border-radius:24px;box-shadow:0 30px 90px rgba(0,0,0,.38);animation:rise .25s ease}.provider-dialog-head{display:flex;justify-content:space-between;align-items:center;padding:25px 28px;background:linear-gradient(125deg,#063e37 0%,#087f70 65%,#16a58f 100%);color:#fff}.provider-dialog-head h2{margin:0;font-size:22px;letter-spacing:-.3px}.provider-dialog-head h2:before{content:'+';display:inline-grid;place-items:center;width:26px;height:26px;margin-right:10px;border-radius:8px;background:rgba(255,255,255,.18)}.modal-close{width:38px;height:38px;border:1px solid rgba(255,255,255,.28);border-radius:12px;background:rgba(255,255,255,.12);font-size:27px;line-height:1;cursor:pointer;color:#fff;transition:.18s}.modal-close:hover{background:#fff;color:#087565;transform:rotate(90deg)}.provider-form{padding:28px;display:grid;grid-template-columns:1fr 1fr;gap:18px;background:linear-gradient(180deg,#fff,#f6fbfa)}.provider-form textarea{min-height:105px;resize:vertical}.provider-form .wide{grid-column:1/-1}.provider-form input,.provider-form textarea{box-sizing:border-box;border:1px solid #d6e6e2!important;border-radius:12px!important;background:#fff;padding:13px 14px;transition:.18s;box-shadow:0 2px 7px rgba(8,91,79,.03)}.provider-form input:focus,.provider-form textarea:focus{border-color:#17a28d!important;box-shadow:0 0 0 4px rgba(23,162,141,.12);outline:0}.provider-form label{padding:12px 14px;background:#edf8f6;border:1px solid #d4ece7;border-radius:12px;color:#15594f;font-weight:600}.provider-form-actions{grid-column:1/-1;display:flex;justify-content:flex-end;gap:10px;margin:8px -28px -28px;padding:18px 28px;background:#fff;border-top:1px solid #e3eeeb}.provider-form-actions .btn{min-width:118px;border-radius:10px}.provider-filter{background:#fff;border:1px solid #e1ecea;border-radius:14px;padding:14px;margin:18px 0;box-shadow:0 5px 16px rgba(10,70,62,.05)}.provider-card{border-radius:16px;overflow:hidden;box-shadow:0 8px 24px rgba(10,70,62,.08)}.provider-card .card-header{padding:18px 22px;background:linear-gradient(90deg,#f3fbfa,#fff)}.provider-name{color:#073e37}.action-group{display:flex;gap:7px;align-items:center}.icon-action{width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;border:1px solid #dbe8e5;border-radius:9px;background:#fff;color:#0b6f63;font-size:16px;cursor:pointer;text-decoration:none;transition:.18s}.icon-action:hover{transform:translateY(-1px);background:#e8f7f4;border-color:#8dd7cb}.icon-action.delete{color:#c23b4a}.icon-action.delete:hover{background:#fff0f1;border-color:#f3afb8}.action-group form{margin:0}.status-dot{display:inline-flex;align-items:center;gap:6px}.status-dot:before{content:'';width:7px;height:7px;border-radius:50%;background:currentColor}@keyframes fade{from{opacity:0}to{opacity:1}}@keyframes rise{from{opacity:0;transform:translateY(15px) scale(.98)}to{opacity:1;transform:none}}@media(max-width:620px){.provider-form{grid-template-columns:1fr;padding:20px}.provider-form .wide{grid-column:auto}.provider-form-actions{margin:6px -20px -20px;padding:16px 20px}.provider-dialog{border-radius:18px}.provider-dialog-head{padding:20px}.provider-modal{padding:12px}}
</style></head><body><div class="layout"><c:set var="activeModule" value="providers" scope="request"/><%@ include file="/WEB-INF/views/common/_sidebar.jsp" %><main class="main-content main-content-wide"><div class="page-header"><h1>Quản lý nhà cung cấp</h1><p class="page-sub">Danh sách và thông tin liên hệ nhà cung cấp</p><div class="page-actions"><button type="button" class="btn btn-primary" id="openProviderModal">+ Thêm nhà cung cấp</button></div></div><%@ include file="/WEB-INF/views/common/_flash.jsp" %>
<form class="filter-bar provider-filter" method="get"><input class="form-control" name="q" value="<c:out value='${q}'/>" placeholder="Tìm theo tên, người liên hệ, điện thoại hoặc email..."><button class="btn btn-secondary">Lọc</button><a class="btn btn-outline" href="${pageContext.request.contextPath}/admin/providers">Xóa lọc</a></form>
<div class="card provider-card"><div class="card-header"><span class="card-title">Danh sách nhà cung cấp</span><span class="text-soft">${providers.size()} nhà cung cấp</span></div><table class="data-table"><thead><tr><th>#</th><th>Tên</th><th>Người liên hệ</th><th>Điện thoại</th><th>Email</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:choose><c:when test="${empty providers}"><tr><td colspan="7" style="text-align:center;padding:24px">Chưa có nhà cung cấp phù hợp.</td></tr></c:when><c:otherwise><c:forEach items="${providers}" var="p" varStatus="i"><tr><td>${i.count}</td><td><strong class="provider-name"><c:out value="${p.name}"/></strong></td><td><c:out value="${empty p.contactPerson ? '-' : p.contactPerson}"/></td><td><c:out value="${empty p.phone ? '-' : p.phone}"/></td><td><c:out value="${empty p.email ? '-' : p.email}"/></td><td><span class="badge ${p.active ? 'badge-success' : 'badge-error'} status-dot">${p.active ? 'Hoạt động' : 'Ngừng'}</span></td><td><div class="action-group"><a class="icon-action" title="Sửa nhà cung cấp" aria-label="Sửa" href="${pageContext.request.contextPath}/admin/providers?edit=${p.providerID}">✏</a><form method="post" action="${pageContext.request.contextPath}/admin/providers"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${p.providerID}"><button class="icon-action delete" title="Xóa nhà cung cấp" aria-label="Xóa" onclick="return confirm('Xóa nhà cung cấp này?')">🗑</button></form></div></td></tr></c:forEach></c:otherwise></c:choose></tbody></table></div></main></div>
<div class="provider-modal ${not empty provider ? 'open' : ''}" id="providerModal" role="dialog" aria-modal="true"><div class="provider-dialog"><div class="provider-dialog-head"><h2>${empty provider ? 'Thêm nhà cung cấp' : 'Cập nhật nhà cung cấp'}</h2><button type="button" class="modal-close" data-close-modal aria-label="Đóng">×</button></div><form class="provider-form" method="post" action="${pageContext.request.contextPath}/admin/providers"><input type="hidden" name="providerID" value="${provider.providerID}"><input required class="form-control no-icon" name="name" placeholder="Tên nhà cung cấp *" value="<c:out value='${provider.name}'/>"><input class="form-control no-icon" name="contactPerson" placeholder="Người liên hệ" value="<c:out value='${provider.contactPerson}'/>"><input class="form-control no-icon" name="phone" placeholder="Số điện thoại" value="<c:out value='${provider.phone}'/>"><input class="form-control no-icon" type="email" name="email" placeholder="Email" value="<c:out value='${provider.email}'/>"><input class="form-control no-icon wide" name="address" placeholder="Địa chỉ" value="<c:out value='${provider.address}'/>"><input class="form-control no-icon" name="taxCode" placeholder="Mã số thuế" value="<c:out value='${provider.taxCode}'/>"><label style="display:flex;align-items:center;gap:8px"><input type="checkbox" name="active" ${empty provider || provider.active ? 'checked' : ''}> Đang hoạt động</label><textarea class="form-control no-icon wide" name="note" placeholder="Ghi chú"><c:out value="${provider.note}"/></textarea><div class="provider-form-actions"><button type="button" class="btn btn-outline" data-close-modal>Hủy</button><button class="btn btn-primary">${empty provider ? 'Thêm mới' : 'Lưu thay đổi'}</button></div></form></div></div>
<script>const modal=document.getElementById('providerModal');document.getElementById('openProviderModal').addEventListener('click',()=>modal.classList.add('open'));document.querySelectorAll('[data-close-modal]').forEach(b=>b.addEventListener('click',()=>modal.classList.remove('open')));modal.addEventListener('click',e=>{if(e.target===modal)modal.classList.remove('open')});</script></body></html>
